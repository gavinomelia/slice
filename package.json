{
  "name": "pr-review-workspace",
  "version": "1.0.0",
  "description": "Slice-grouped PR review: a shared analysis pipeline with a terminal and a browser viewer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/config",
    "packages/core",
    "packages/tui",
    "packages/web"
  ],
  "scripts": {
    "review": "node packages/core/bin/pr-review.mjs",
    "tui": "node packages/tui/bin/pr-review-tui.mjs",
    "web": "npm run dev --workspace @pr-review/web",
    "check": "npm run check --workspace @pr-review/web"
  },
  "license": "ISC"
}
