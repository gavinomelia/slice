{
  "name": "@gavinomelia/slice",
  "version": "0.1.0",
  "description": "Read a pull request as behavioral slices, not as a pile of files — an AI-analyzed diff in your terminal",
  "keywords": [
    "pull-request",
    "code-review",
    "cli",
    "tui",
    "ink",
    "github",
    "diff",
    "claude"
  ],
  "license": "MIT",
  "author": "Gavin O'Melia",
  "homepage": "https://github.com/gavinomelia/slice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinomelia/slice.git"
  },
  "bugs": "https://github.com/gavinomelia/slice/issues",
  "type": "module",
  "bin": {
    "slice": "./bin/slice.mjs"
  },
  "exports": {
    ".": "./src/viewer/app.mjs",
    "./config": "./src/config/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "slice": "node bin/slice.mjs",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.6",
    "ink": "^6.6.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
